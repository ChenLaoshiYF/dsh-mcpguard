{
    "name":  "dsh-mcpguard",
    "version":  "0.2.0",
    "description":  "Mingleng mcpguard for DeepSeek Harness 鈥?the first security plugin for DSH. Scans skills and MCP configs for prompt injection, homoglyphs, hidden Unicode, dangerous shell and credential leaks.",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "README.zh.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "node test/smoke.mjs \u0026\u0026 node test/robust.mjs"
                },
    "devDependencies":  {
                            "typescript":  "^5.5.0",
                            "@types/node":  "^22.0.0"
                        },
    "license":  "MIT"
}
