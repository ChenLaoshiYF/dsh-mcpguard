{
    "name":  "dsh-mcpguard",
    "version":  "0.1.2",
    "description":  "鏄庢１ mcpguard for DeepSeek Harness: scan skills, tools and MCP configs for prompt injection, homoglyph and tool poisoning.",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "node --test lib/__tests__/*.test.js"
                },
    "devDependencies":  {
                            "typescript":  "^5.5.0",
                            "@types/node":  "^22.0.0"
                        },
    "license":  "MIT"
}
